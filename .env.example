# ==============================================================================
# FIXORA Environment Configuration Template (.env.example)
# Autonomous Code Repair and Incident Intelligence Platform
#
# Instructions:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Fill in your credentials below (GitHub Token, AI API keys).
# 3. Security keys (JWT_SECRET, GITHUB_WEBHOOK_SECRET) should be generated
#    using: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ==============================================================================

# --- Application Core ---
PROJECT_NAME=FIXORA
VERSION=1.0.0
API_V1_STR=/api
ENVIRONMENT=development

# --- Optional Initial Administrator Bootstrap (Option A) ---
# If configured, creates this administrator on startup if the database is currently empty.
# In production, if not set, the first user who registers through /auth/register becomes administrator.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Authentication & Cryptographic Secrets ---
# Required in production: Minimum 32-character high-entropy secret for signing JWT tokens (HS256).
# Startup fails in production if this is missing or fewer than 32 characters.
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters_random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Deployment & CORS Security ---
# Comma-separated list of allowed web origins. In production, wildcard '*' and localhost are strictly forbidden.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# --- Database Connection (Async SQLAlchemy) ---
# Local SQLite database (default for development):
DATABASE_URL=sqlite+aiosqlite:///./fixora.db
# PostgreSQL (Production / Render):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fixora

# --- Cache & Queues (Redis - Optional) ---
# Background tasks execute in-process if REDIS_URL is not provided.
# REDIS_URL=redis://localhost:6379/0

# --- Vector Knowledge Base (Qdrant - Optional) ---
# Ephemeral in-memory vector store is used automatically if remote Qdrant is unavailable or unconfigured.
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# --- Graph Database (Neo4j - Optional with in-memory topology fallback) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fixora_neo4j_password

# --- GitHub Integration ---
# Required for: High rate limits (5,000 req/hr), private repos, and automated PRs
# Generate a Personal Access Token at: https://github.com/settings/tokens
# Required scopes: repo, read:org
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_min_32_chars_random

# --- AI & Reasoning Engine Providers ---
# Configure at least one provider for autonomous patch synthesis and code reasoning
# Gemini API Key: Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key: Obtain from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude API Key (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Sandbox Execution ---
DOCKER_MEMORY_LIMIT=2048 MB
SANDBOX_TIMEOUT_SECONDS=15

# --- Frontend Settings ---
VITE_API_URL=/api
