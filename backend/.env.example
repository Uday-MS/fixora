# ==========================================
# FIXORA Backend Environment Configuration
# ==========================================

# Application
PROJECT_NAME=FIXORA
VERSION=1.0.0
API_V1_STR=/api
ENVIRONMENT=development

# Security & JWT Auth
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters_random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (Async SQLAlchemy)
# Default SQLite fallback for local test/dev:
DATABASE_URL=sqlite+aiosqlite:///./fixora.db
# PostgreSQL (Production / Docker):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fixora

# Cache & Queues (Redis)
REDIS_URL=redis://localhost:6379/0

# Vector Knowledge Base (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Graph Database (Neo4j - Optional / Future phases)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fixora_neo4j_password

# LLM & Reasoning Providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Static Analysis & AST Tooling (Prompt 3 & beyond)
RUFF_BINARY_PATH=/usr/local/bin/ruff
BANDIT_BINARY_PATH=/usr/local/bin/bandit
SEMGREP_BINARY_PATH=/usr/local/bin/semgrep

# GitHub Integration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
